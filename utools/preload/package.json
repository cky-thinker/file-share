{
  "name": "file-share-utools",
  "version": "v1.0.8",
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');const path=require('path');const dir='node_modules/registry-js/dist/lib';if(fs.existsSync(dir)){for(const f of fs.readdirSync(dir)){if(f.endsWith('.map')){fs.rmSync(path.join(dir,f),{force:true});}}}\"",
    "install:prod": "node ../../scripts/prepare-utools-preload-deps.js",
    "prepare:bundle-deps": "node ../../scripts/prepare-utools-preload-deps.js"
  },
  "dependencies": {
    "@file-share/shared-utils": "workspace:*",
    "node-machine-id": "^1.1.12",
    "uuid": "^9.0.1"
  }
}
